<?xml version="1.0" encoding="UTF-8"?>
<Dashboard xmlns="http://soap.sforce.com/2006/04/metadata">
	<backgroundEndColor>#FFFFFF</backgroundEndColor>
	<backgroundFadeDirection>Diagonal</backgroundFadeDirection>
	<backgroundStartColor>#FFFFFF</backgroundStartColor>
	<chartTheme>light</chartTheme>
	<colorPalette>unity</colorPalette>
	<dashboardChartTheme>light</dashboardChartTheme>
	<dashboardColorPalette>unity</dashboardColorPalette>
	<description>Dashboard tracking the evolution of Daily Delivered Platform Events usage</description>
	<leftSection>
		<columnSize>Medium</columnSize>
		<components>
			<autoselectColumnsFromReport>true</autoselectColumnsFromReport>
			<chartAxisRange>Auto</chartAxisRange>
			<componentType>LineGrouped</componentType>
			<decimalPrecision>-1</decimalPrecision>
			<displayUnits>Auto</displayUnits>
			<drillEnabled>false</drillEnabled>
			<drillToDetailEnabled>false</drillToDetailEnabled>
			<enableHover>false</enableHover>
			<expandOthers>false</expandOthers>
			<footer>Daily Platform Events Usage Trend</footer>
			<header>Daily Delivered Platform Events - Usage Over Time</header>
			<legendPosition>Right</legendPosition>
			<report>OrgSnapshot/DailyDeliveredPlatformEvents_Evolution</report>
			<sortBy>RowLabelAscending</sortBy>
			<title>Daily Platform Events Usage Trend</title>
			<useReportChart>false</useReportChart>
		</components>
		<components>
			<autoselectColumnsFromReport>true</autoselectColumnsFromReport>
			<componentType>Table</componentType>
			<decimalPrecision>-1</decimalPrecision>
			<displayUnits>Auto</displayUnits>
			<drillEnabled>false</drillEnabled>
			<drillToDetailEnabled>false</drillToDetailEnabled>
			<footer>Detailed platform events data</footer>
			<header>Platform Events Detail Table</header>
			<indicatorBreakpoint1>75.0</indicatorBreakpoint1>
			<indicatorBreakpoint2>90.0</indicatorBreakpoint2>
			<indicatorHighColor>#C23934</indicatorHighColor>
			<indicatorLowColor>#00716B</indicatorLowColor>
			<indicatorMiddleColor>#FFB75D</indicatorMiddleColor>
			<maxValuesDisplayed>10</maxValuesDisplayed>
			<report>OrgSnapshot/DailyDeliveredPlatformEvents_Evolution</report>
			<sortBy>RowLabelDescending</sortBy>
			<title>Recent Platform Events Data</title>
			<useReportChart>false</useReportChart>
		</components>
	</leftSection>
	<middleSection>
		<columnSize>Medium</columnSize>
		<components>
			<autoselectColumnsFromReport>true</autoselectColumnsFromReport>
			<chartAxisRange>Auto</chartAxisRange>
			<componentType>Bar</componentType>
			<decimalPrecision>-1</decimalPrecision>
			<displayUnits>Auto</displayUnits>
			<drillEnabled>false</drillEnabled>
			<drillToDetailEnabled>false</drillToDetailEnabled>
			<enableHover>false</enableHover>
			<expandOthers>false</expandOthers>
			<footer>Latest daily snapshots</footer>
			<header>Recent Daily Usage</header>
			<legendPosition>Right</legendPosition>
			<maxValuesDisplayed>7</maxValuesDisplayed>
			<report>OrgSnapshot/DailyDeliveredPlatformEvents_Evolution</report>
			<sortBy>RowLabelDescending</sortBy>
			<title>Last 7 Days Usage</title>
			<useReportChart>false</useReportChart>
		</components>
	</middleSection>
	<rightSection>
		<columnSize>Medium</columnSize>
		<components>
			<autoselectColumnsFromReport>true</autoselectColumnsFromReport>
			<componentType>Metric</componentType>
			<decimalPrecision>0</decimalPrecision>
			<displayUnits>Auto</displayUnits>
			<footer>Key statistics from platform events usage</footer>
			<header>Usage Statistics</header>
			<indicatorBreakpoint1>75.0</indicatorBreakpoint1>
			<indicatorBreakpoint2>90.0</indicatorBreakpoint2>
			<indicatorHighColor>#C23934</indicatorHighColor>
			<indicatorLowColor>#00716B</indicatorLowColor>
			<indicatorMiddleColor>#FFB75D</indicatorMiddleColor>
			<report>OrgSnapshot/DailyDeliveredPlatformEvents_Evolution</report>
			<title>Platform Events Metrics</title>
			<useReportChart>false</useReportChart>
		</components>
	</rightSection>
	<dashboardType>LoggedInUser</dashboardType>
	<textColor>#000000</textColor>
	<title>Daily Delivered Platform Events - Monitoring Dashboard</title>
	<titleColor>#000000</titleColor>
	<titleSize>12</titleSize>
</Dashboard>